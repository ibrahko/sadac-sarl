[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    migrations,
    .venv,
    venv,
    env,
    staticfiles,
    htmlcov,
    media

# Ignorer certaines erreurs courantes
ignore =
    # Whitespace before ':'
    E203,
    # Line too long (géré par max-line-length)
    E501,
    # Line break before binary operator
    W503

per-file-ignores =
    # __init__.py peut avoir des imports inutilisés
    __init__.py:F401
    # settings peut avoir des lignes longues et imports *
    settings/*.py:E501,F401,F403,F405
